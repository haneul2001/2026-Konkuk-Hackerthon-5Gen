# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git에 올라가지 않는다.

# --- 요약 LLM ---
# 서버 기본 요약 제공자: claude | gemini | exaone | qwen
SUMMARY_PROVIDER=qwen

# Claude (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Gemini (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# 비용 계산용 (달러/1M 토큰, 요금표 확인 후 입력)
# GEMINI_PRICE_IN=
# GEMINI_PRICE_OUT=

# 로컬 (Ollama)
# OLLAMA_HOST=http://localhost:11434
# EXAONE_MODEL=exaone3.5:7.8b
# QWEN_MODEL=qwen3:8b
# OLLAMA_NUM_CTX=32768

# --- 공부 자료 링크 (네이버 검색 API, https://developers.naver.com 에서 '검색' API 발급) ---
# 없으면 위키백과 링크만 붙는다. 링크할 블로그 도메인은 trusted_sites.txt
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- STT ---
# WHISPER_MODEL=large-v3-turbo
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
